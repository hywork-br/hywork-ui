{
  "name": "@hywork/ui",
  "version": "0.6.0",
  "description": "Design system da Hywork — tokens, componentes React e padrões de produto",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hywork-br/hywork-ui.git"
  },
  "files": [
    "dist",
    "tokens",
    "tailwind",
    "manifest.json",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./tokens/tema.css",
    "./manifest.json": "./manifest.json",
    "./tokens/tema.css": "./tokens/tema.css",
    "./tokens/white-label.css": "./tokens/white-label.css",
    "./tokens/primitivos.css": "./tokens/primitivos.css",
    "./tokens/semantico.css": "./tokens/semantico.css",
    "./tokens/admin.css": "./tokens/admin.css",
    "./tokens/portal.css": "./tokens/portal.css",
    "./tokens/componentes.css": "./tokens/componentes.css",
    "./tailwind/v4.css": "./tailwind/v4.css",
    "./tailwind/v3-preset.cjs": "./tailwind/v3-preset.cjs"
  },
  "scripts": {
    "audit:consumers": "node scripts/audit-consumers.mjs",
    "audit:adoption": "node scripts/audit-adoption.mjs",
    "build": "tsup && storybook build --quiet",
    "build:lib": "tsup",
    "check": "npm run check:tokens && npm run test && npm run typecheck && npm run build:lib",
    "check:tokens": "node scripts/check-tokens.mjs && node scripts/gerar-preset-v3.mjs --check",
    "preset": "node scripts/gerar-preset-v3.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "test": "node --test scripts/*.test.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "sideEffects": [
    "*.css",
    "tokens/*.css"
  ]
}
