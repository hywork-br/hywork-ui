{
  "name": "@hywork/ui",
  "version": "0.7.0",
  "description": "Componentes e tokens derivados do hywork-plataform",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hywork-br/hywork-ui.git"
  },
  "files": [
    "dist",
    "tokens",
    "tailwind",
    "manifest.json",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens/platform.css": "./tokens/platform.css",
    "./tailwind/platform-preset.cjs": "./tailwind/platform-preset.cjs",
    "./manifest.json": "./manifest.json"
  },
  "sideEffects": [
    "*.css",
    "tokens/*.css"
  ],
  "scripts": {
    "derive": "node scripts/derive-platform.mjs",
    "check": "node --test scripts/*.test.mjs && npm run typecheck && npm run build:lib && vitest run",
    "typecheck": "tsc --noEmit",
    "build:lib": "tsup",
    "build:css": "node scripts/build-css.mjs",
    "build": "npm run build:lib && npm run build:css && storybook build --quiet",
    "storybook": "npm run build:css && storybook dev -p 6006 --no-open",
    "test": "vitest run",
    "test:browser": "playwright test",
    "smoke:consumer": "node scripts/smoke-consumer.mjs",
    "prepare": "npm run build:lib"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-tooltip": "1.1.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.454.0",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@fontsource-variable/montserrat": "5.3.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.4",
    "axe-core": "^4.13.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "10.5.10",
    "tailwindcss": "3.4.17",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
