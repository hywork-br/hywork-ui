{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true, "esModuleInterop": true, "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "resolveJsonModule": true, "noEmit": true,
    "skipLibCheck": true, "strict": true, "target": "ES2022",
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "stories", ".storybook", "provenance/platform/components", "provenance/platform/lib", "tests", "*.config.ts"]
}
